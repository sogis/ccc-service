    {
      "vulnerability": {
        "name": "CVE-2026-47884",
        "aliases": [
          "GHSA-pc63-qcmh-9cmg"
        ]
      },
      "timestamp": "2026-11-24T00:00:00Z",
      "products": [
        {
          "@id": "pkg:oci/ccc-service?repository_url=index.docker.io/sogis/ccc-service",
          "subcomponents": [
            {
              "@id": "pkg:maven/org.springframework/spring-webmvc"
            }
          ]
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "XsltView SSRF/RCE. Requires an XsltView used for view rendering via a '/**' mapping without explicit view name. The application defines no XsltView, ViewResolver or view-returning controller and has no template engine; the only controller (StatusPage) is a @RestController returning text/plain. The only view Spring Boot renders is the whitelabel error page (a fixed, non-XSLT view); the default '/**' static-resource mapping serves resources, not views. Affects 6.2.0-6.2.19; fixed for 6.2.x only in 6.2.20 (Spring Enterprise Support only), open-source fix in 7.0.9 (Spring Boot 4). Grype/NVD lists CVSS 9.8; Spring rates it MEDIUM (CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:N/A:N)."
    },
    {
      "vulnerability": {
        "name": "CVE-2026-47890",
        "aliases": [
          "GHSA-j9f9-w8pj-32f8"
        ]
      },
      "timestamp": "2026-11-24T00:00:00Z",
      "products": [
        {
          "@id": "pkg:oci/ccc-service?repository_url=index.docker.io/sogis/ccc-service",
          "subcomponents": [
            {
              "@id": "pkg:maven/org.springframework/spring-webmvc"
            }
          ]
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "SSE stream corruption with view fragments. Requires sending view fragments over Server-Sent Events with attacker-controlled data. The application uses no SSE (no SseEmitter, ServerSentEvent, text/event-stream), no view fragments and no WebFlux; messages are relayed over WebSocket only. Affects 6.2.0-6.2.19; fixed for 6.2.x only in 6.2.20 (Spring Enterprise Support only), open-source fix in 7.0.9 (Spring Boot 4). Grype/NVD lists CVSS 9.8; Spring rates it LOW (CVSS:3.1/AV:N/AC:H/PR:L/UI:R/S:U/C:N/I:L/A:N)."
    },
